# Required for apartment searches and provider enrichment.
CONTEXT_DEV_API_KEY=

# Optional for `npm run dev`; both are required for persistent inventory,
# `npm run cache:warm`, and the scheduled refresh route.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required only when exposing the scheduled refresh route in production.
# Generate a long, random value and never expose it to browser code.
CRON_SECRET=

# Optional canonical URL used for social metadata.
# NEXT_PUBLIC_SITE_URL=https://criblist.example.com
